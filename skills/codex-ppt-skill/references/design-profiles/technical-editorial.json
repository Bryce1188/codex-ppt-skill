  "layouts": {
    "feature": "固定页眉下放一张主截图，旁边仅解释与当前用户任务有关的操作。截图比例保真。",
    "architecture": "主调用路径与必要支路配合关键处理步骤，充分解释一次实际操作；同类节点保持相同填充。",
    "dataModel": "核心实体包含讲解所需的关键字段，关系与约束就近说明；避免空的大框和泛泛的总结。",
    "results": "一个主要结果图配必要口径；完整表格和实现细节放附录。"
  },
  "imageTreatment": {
    "evidence": "contain，保留原图、坐标和标签",
    "background": "默认用主题底色；需要题材插图时固定构图、色温与留白，不逐页搜索新模板"
  },
  "forbidden": [
    "把所有项目都套成蓝色科技风",
    "同一套内页随意切换深浅底",
    "通过换背景代替信息设计",
    "把原生图表转换成整页截图",
    "没有明确语义就给某个同类节点单独换填充色",
    "每页固定左下角制作说明、验证说明或模板套话",
    "用空框和大面积无用途留白代替必要的流程、数据或解释"
  ],
